# Worlds backend (FastAPI on Modal) that fronts the Volume holding splats, VPS maps and meshes.
# Leave unset to read the same worlds/<id>/... layout from ../../maps/assets instead.
WANDER_API_URL=
# Shared secret sent as `X-API-Key` on every backend request (see shared/contracts/README.md).
# Must match the WANDER_API_KEY secret configured on the Modal app. Never exposed to the browser.
WANDER_API_KEY=
# Optional override for the local assets directory used when WANDER_API_URL is unset.
WANDER_ASSETS_DIR=
