OPENAI_API_KEY=
# Required for every HTTP/WebSocket request (including /health).
WANDER_API_KEY=
# Local storage defaults to maps/assets; Modal sets WANDER_DATA_ROOT=/data.
OPENAI_MODEL=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTIC_EMBEDDING_ENDPOINT=
ELASTIC_RERANK_ENDPOINT=
ELASTIC_EMBEDDING_DIMS=1024
ELASTIC_EMBEDDING_PROVIDER=jinaai
# Reasoning effort for the delegated agent (voice turns wait on it); blank for models without reasoning.
OPENAI_REASONING_EFFORT=low
# Offline annotation and opt-in Live voice bridge (shared/contracts/voice.md, docs/VOICE_AGENT_PLAN.md)
ANNOTATION_MODEL=gpt-5-mini
OPENAI_LIVE_MODEL=gpt-live-1
VOICE_ENABLED=false
# Separate demo access token, not your OpenAI key. Required if voice is enabled.
VOICE_ACCESS_TOKEN=
VOICE_NAME=marin
VOICE_CONTEXT_INTERVAL_S=5
VOICE_TRANSCRIPT_GRACE_S=0.7
VOICE_MAX_MINUTES=60
# Log every Live server event with timeline fields (includes transcript text); Phase 0 checks only.
VOICE_TRACE=false
