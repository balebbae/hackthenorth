OPENAI_API_KEY=
# Required for every HTTP/WebSocket request (including /health).
WANDER_API_KEY=
# Local storage defaults to maps/assets; Modal sets WANDER_DATA_ROOT=/data.
OPENAI_MODEL=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTIC_EMBEDDING_ENDPOINT=
ELASTIC_RERANK_ENDPOINT=
ELASTIC_EMBEDDING_DIMS=1024
ELASTIC_EMBEDDING_PROVIDER=jinaai
# Offline annotation and opt-in Live voice bridge
ANNOTATION_MODEL=gpt-5-mini
OPENAI_LIVE_MODEL=gpt-live-1
VOICE_ENABLED=false
# Separate demo access token, not your OpenAI key. Required if voice is enabled.
VOICE_ACCESS_TOKEN=
